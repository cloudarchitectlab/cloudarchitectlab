---
import CaseStudyCard from "./CaseStudyCard.astro";
---

<section class="featured-case-studies wide-section">
  <p class="eyebrow">CASE STUDIES</p>

  <h2>Featured Architecture</h2>

  <p class="section-intro">
    Each Cloud Architect Lab case study is designed, implemented, documented,
    and validated as a reusable engineering reference.
  </p>

  <div class="case-card-grid">
    <CaseStudyCard
      id="CAL-005"
      title="Deterministic Mermaid Evidence Extraction"
      category="AI Evaluation"
      complexity="Advanced"
      status="Completed"
      philosophy={["Evidence as Data.", "Evaluation by Evidence."]}
      technologies={[
        "Mermaid",
        "Deterministic Parsing",
        "Controlled Rendering",
        "AI Evaluation"
      ]}
      description="Preserves architecture evidence through deterministic Mermaid extraction, then tests whether multiple AI evaluators can detect explicit defects and missing required relationships."
      href="/case-studies/deterministic-mermaid-evidence-extraction"
    />

    <CaseStudyCard
      id="CAL-004"
      title="AI Architecture Evaluator"
      category="AI Evaluation"
      complexity="Advanced"
      status="Completed"
      philosophy={["Architecture as Code.", "Evaluation by Evidence."]}
      technologies={[
        "Mermaid",
        "Governed Knowledge",
        "Structured Findings",
        "AI Evaluation"
      ]}
      description="Tests grounded architecture conformance evaluation: whether AI can inspect machine-readable architecture against authoritative requirements and support its findings with evidence and citations."
      href="/case-studies/ai-architecture-evaluator"
    />

  </div>
</section>
