---
import CaseStudyCard from "./CaseStudyCard.astro";
---

<section class="featured-case-studies wide-section">
  <p class="eyebrow">CASE STUDIES</p>

  <h2>Featured Architecture</h2>

  <p class="section-intro">
    Each Cloud Architect Lab case study is designed, implemented, documented,
    and validated as a reusable engineering reference.
  </p>

  <div class="case-card-grid">
    <CaseStudyCard
      id="CAL-004"
      title="AI Architecture Evaluator"
      category="AI Evaluation"
      complexity="Advanced"
      status="In progress"
      philosophy={["Architecture as Code.", "Evaluation by Evidence."]}
      technologies={[
        "Mermaid",
        "Governed Knowledge",
        "Structured Findings",
        "AI Evaluation"
      ]}
      description="Tests grounded architecture conformance evaluation: whether AI can inspect machine-readable architecture against authoritative requirements and support its findings with evidence and citations."
      href="/case-studies/ai-architecture-evaluator"
    />

    <CaseStudyCard
      id="CAL-003"
      title="AI Knowledge Assistant"
      category="Generative AI"
      complexity="Advanced"
      status="Completed"
      philosophy={["Knowledge as Code.", "Authority by Design."]}
      technologies={[
        "Amazon Bedrock",
        "Titan Embeddings V2",
        "S3 Vectors",
        "Claude Haiku 4.5"
      ]}
      description="Builds a governed RAG system over Cloud Architect Lab documentation, with metadata-aware retrieval, grounded responses, citations, adversarial evaluation, and security controls that separate semantic relevance from knowledge authority."
      href="/case-studies/ai-knowledge-assistant"
    />

    <CaseStudyCard
      id="CAL-002"
      title="Enterprise VPC Peering"
      category="Enterprise Networking"
      complexity="Intermediate"
      status="Completed"
      technologies={[
        "AWS",
        "Terraform",
        "VPC Peering",
        "NAT Gateway",
        "Network ACLs"
      ]}
      description="Models a healthcare-oriented enterprise network using separate Shared Services and Patient Platform VPCs, reusable Terraform modules, private peering routes, controlled outbound access, and layered security."
      href="/case-studies/enterprise-vpc-peering"
    />

    <CaseStudyCard
      id="CAL-001"
      title="AWS Networking Foundations"
      category="Cloud Networking"
      complexity="Foundational"
      status="Completed"
      technologies={["AWS", "Terraform", "Amazon VPC", "Mermaid"]}
      description="Establishes a production-inspired AWS networking foundation using Terraform, with public and private subnet separation, explicit routing, security boundaries, architecture diagrams, and validation evidence."
      href="/case-studies/aws-networking-foundations"
    />
  </div>
</section>
